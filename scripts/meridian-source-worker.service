[Unit]
Description=Meridian - worker d'ingestion pull-first des sources
Documentation=file:///opt/meridian/docs/architecture/ingestion-continue.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# Adapter ces chemins et cet utilisateur à l'installation réelle (ne pas exécuter en root).
# User=meridian
# Group=meridian
WorkingDirectory=/opt/meridian/backend
EnvironmentFile=/opt/meridian/backend/.env
Environment=JUMEAU_WORKSPACE=/var/lib/meridian
Environment=HOME=/var/lib/meridian
StateDirectory=meridian
ExecStart=/opt/meridian/backend/.venv/bin/python -m jumeau.source_worker
Restart=always
RestartSec=5
TimeoutStopSec=30
# Le worker n'écoute aucun port ; il lit Postgres/Mongo et les sources.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/meridian

[Install]
WantedBy=multi-user.target
