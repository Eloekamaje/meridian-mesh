# Laboratoire AWS local Floci — copier vers .env.floci.local (ignoré par Git)
# puis : set -a; . ./.env.floci.local; set +a
#
# Les noms correspondent aux ressources créées par infra/floci (préfixe « meridian »,
# région ca-central-1, compte 000000000000). Si vous changez le préfixe ou la région,
# régénérez ce fichier avec : scripts/dev-floci.sh env

# Endpoint et credentials factices Floci
AWS_ENDPOINT_URL=http://127.0.0.1:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_SESSION_TOKEN=test
AWS_REGION=ca-central-1
AWS_DEFAULT_REGION=ca-central-1
JUMEAU_AWS_REGION=ca-central-1

# Pièces et artefacts
JUMEAU_PIECES_STORAGE=s3
JUMEAU_PIECES_S3_BUCKET=meridian-pieces
JUMEAU_PIECES_S3_PREFIX=local
JUMEAU_PIECES_S3_ENDPOINT=http://127.0.0.1:4566
JUMEAU_PIECES_S3_REGION=ca-central-1
JUMEAU_PIECES_S3_FORCE_PATH_STYLE=1

JUMEAU_INDEX_STORE=s3
JUMEAU_INDEX_BUCKET=meridian-index
JUMEAU_INDEX_ENDPOINT=http://127.0.0.1:4566
JUMEAU_INDEX_REGION=ca-central-1
JUMEAU_INDEX_PREFIX=meridian/index
JUMEAU_INDEX_SSE=aws:kms
JUMEAU_INDEX_KMS_KEY=alias/meridian-local

# Sessions Flore dans S3 (bucket/prefixe)
JUMEAU_SESSIONS_S3=meridian-sessions/flore

# Outbox, EventBridge et Scheduler
# Le publisher Méridian préfère SQS dès que cette URL est définie.
JUMEAU_SQS_QUEUE_URL=http://127.0.0.1:4566/000000000000/meridian-outbox
# Bus alternatif provisionné et testé par le smoke ; le runtime choisit SQS tant que
# JUMEAU_SQS_QUEUE_URL est définie.
JUMEAU_EVENTBRIDGE_BUS=meridian
JUMEAU_SCHEDULER_ROLE_ARN=arn:aws:iam::000000000000:role/meridian-scheduler
JUMEAU_SCHEDULER_TARGET_ARN=arn:aws:sqs:ca-central-1:000000000000:meridian-source-wakeup
JUMEAU_SCHEDULER_GROUP=meridian

# Secrets : Secrets Manager n'est qu'un adaptateur AWS optionnel.
# En cible, le coffre principal est Vault : vault:meridian/webhook#jeton
JUMEAU_WEBHOOK_SECRET=aws:meridian/local#webhook_secret

# Bedrock local : Floci répond avec un stub. Ne pas utiliser pour juger un modèle.
# JUMEAU_MODELE=bedrock
# BEDROCK_REGION=ca-central-1
# BEDROCK_MODELES={"chat":"anthropic.claude-3-haiku-20240307-v1:0","embedding":"amazon.titan-embed-text-v2:0"}
