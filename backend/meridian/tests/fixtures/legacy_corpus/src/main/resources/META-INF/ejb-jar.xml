<?xml version="1.0" encoding="UTF-8"?>
<ejb-jar version="3.0">
  <enterprise-beans>
    <session>
      <ejb-name>ClientEJB</ejb-name>
      <home>com.acme.ClientHome</home>
      <remote>com.acme.ClientRemote</remote>
      <local>com.acme.ClientLocal</local>
      <ejb-class>com.acme.ClientBean</ejb-class>
      <session-type>Stateless</session-type>
    </session>
    <message-driven>
      <ejb-name>ClientMDB</ejb-name>
      <ejb-class>com.acme.ClientMessageBean</ejb-class>
      <destination-type>javax.jms.Queue</destination-type>
    </message-driven>
    <resource-ref>
      <res-ref-name>jdbc/client</res-ref-name>
      <res-type>javax.sql.DataSource</res-type>
      <res-auth>Container</res-auth>
    </resource-ref>
  </enterprise-beans>
</ejb-jar>
