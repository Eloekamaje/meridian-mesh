# Copier vers .env.prod (jamais versionné) et remplacer les valeurs.
APP_ENV=production
AUTH_MODE=proxy
CORS_ORIGINS=https://meridian.example.ca

# Identité du proxy (oauth2-proxy, ALB, etc.)
AUTH_PROXY_SECRET=remplacer-par-un-secret-long

# Moteurs (docker-compose.prod.yml)
MONGO_ROOT_USERNAME=meridian-admin
MONGO_ROOT_PASSWORD=remplacer
REDIS_PASSWORD=remplacer
JUMEAU_PG_PASSWORD=remplacer
MONGO_URL=mongodb://meridian-admin:remplacer@127.0.0.1:27017/meridian_db?authSource=admin
REDIS_URL=redis://:remplacer@127.0.0.1:6379/0
JUMEAU_PG_DSN=postgresql://meridian:remplacer@127.0.0.1:5434/meridian

# Graphe canonique (Neo4j local au compose ; remplacer par Neptune/managed en cloud)
GRAPH_STORE=neo4j
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=remplacer
NEO4J_DATABASE=neo4j
# RLS : passer à 1 après activation explicite des policies et branchement de tous les chemins.
JUMEAU_RLS=0

# Stockage des artefacts d'index (copie source au SHA, réindexable) hors du home du service.
# JUMEAU_INDEX_STORE=local|s3|none ; « none » supprime la copie de travail après ingestion.
JUMEAU_WORKSPACE=/var/lib/meridian
JUMEAU_INDEX_STORE=local
JUMEAU_INDEX_DIR=/var/lib/meridian/index
JUMEAU_INDEX_MAX_OCTETS=1073741824
# Webhook GitHub optionnel : accélérateur pull-first. Absent = webhook désactivé (503).
JUMEAU_WEBHOOK_SECRET=remplacer-par-un-secret-long
# S3/MinIO : renseigner JUMEAU_INDEX_BUCKET et passer JUMEAU_INDEX_STORE=s3.
# Les identifiants viennent de la chaîne boto3 (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY ou rôle IAM),
# jamais de secret dans ce fichier. Chiffrement demandé côté serveur (AES256 ou aws:kms).
#JUMEAU_INDEX_BUCKET=meridian-index
#JUMEAU_INDEX_ENDPOINT=http://127.0.0.1:9000
#JUMEAU_INDEX_REGION=ca-central-1
#JUMEAU_INDEX_PREFIX=meridian/index
#JUMEAU_INDEX_SSE=AES256
#JUMEAU_INDEX_KMS_KEY=

# Modèles : garder les pièces hors d'un fournisseur externe non approuvé.
# DeepSeek est externe : les pièces ne partent pas tant que l'envoi n'est pas explicitement autorisé.
# Pour Bedrock canadien : JUMEAU_MODELE=bedrock, AWS_REGION=ca-central-1.
JUMEAU_MODELE=deepseek
PIECES_ENVOI_MODELE_EXTERNE=0
# Tarifs par million de jetons (estimation affichée ; 0 désactive) et devise.
JUMEAU_COUT_ENTREE_MILLION=0.27
JUMEAU_COUT_SORTIE_MILLION=1.10
JUMEAU_COUT_DEVISE=USD

# Runtime d'exécution : quota de runs actifs par tenant et allowlist d'outils.
# EXECUTION_ALLOWLIST est un JSON tenant -> acteur -> outil -> {lecture:[...], ecriture:[...]}.
# Vide = aucun outil autorisé ; aucune URL n'y est définie. Une écriture doit être listée explicitement.
EXECUTION_MAX_ACTIFS_PAR_TENANT=20
EXECUTION_ALLOWLIST={}
