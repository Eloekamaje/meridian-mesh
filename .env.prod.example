# Copier vers .env.prod (jamais versionné) et remplacer les valeurs.
APP_ENV=production
AUTH_MODE=proxy
CORS_ORIGINS=https://meridian.example.ca

# Identité du proxy (oauth2-proxy, ALB, etc.)
AUTH_PROXY_SECRET=remplacer-par-un-secret-long
AUTH_PERSONA_MAP={"grp-arch":"architecte","grp-paiements":"paiements","grp-support":"support"}

# Moteurs (docker-compose.prod.yml)
MONGO_ROOT_USERNAME=meridian-admin
MONGO_ROOT_PASSWORD=remplacer
REDIS_PASSWORD=remplacer
JUMEAU_PG_PASSWORD=remplacer
MONGO_URL=mongodb://meridian-admin:remplacer@127.0.0.1:27017/meridian_db?authSource=admin
REDIS_URL=redis://:remplacer@127.0.0.1:6379/0
JUMEAU_PG_DSN=postgresql://meridian:remplacer@127.0.0.1:5434/meridian

# Modèles : garder les pièces hors d'un fournisseur externe non approuvé.
# DeepSeek est externe : les pièces ne partent pas tant que l'envoi n'est pas explicitement autorisé.
# Pour Bedrock canadien : JUMEAU_MODELE=bedrock, AWS_REGION=ca-central-1.
JUMEAU_MODELE=deepseek
PIECES_ENVOI_MODELE_EXTERNE=0
